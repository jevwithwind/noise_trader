# Derived data and run artifacts -- never in git (NEEDS licence + size)
results/
logs/
*.parquet
*.csv
*.pkl
*.zip

# The Parquet store lives at D:\MTEC_tick_store, outside the repo, but guard anyway
store/
MTEC_tick_store/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# LaTeX build artifacts (keep .tex, .bib, figures/*.pdf, and the final main.pdf)
report/*.aux
report/*.bbl
report/*.bcf
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.lof
report/*.log
report/*.lot
report/*.out
report/*.run.xml
report/*.synctex.gz
report/*.toc

# Exceptions: the report's own generated inputs ARE tracked so the PDF is reproducible
!report/tables/*.tex
!report/figures/*.pdf
!report/main.pdf

report/*.bcf-SAVE-ERROR
report/*.xdv
